# URL base de la API.
#
# "/api" hace que las llamadas pasen por el proxy de Vite (ver vite.config.ts),
# que reenvia a http://localhost:5000. Es la opción recomendada en desarrollo:
# evita el mixed content (la app sirve por https) y dispense de CORS.
#
# En producción, pon aquí la URL pública del backend, por ejemplo
# VITE_API_URL=https://api.sesco.edu.bo/api
VITE_API_URL=/api

# Sirve el frontend con https y un certificado autofirmado. Necesario para
# probar el lector de QR desde el celular entrando por la IP de la red local.
# Ponlo en false si el celular entra por el túnel de ngrok (ngrok ya aporta
# el HTTPS) o si trabajas solo en http://localhost.
VITE_USE_SSL=false

# Dominios adicionales que el servidor de desarrollo acepta.
#
# Vite 8 rechaza con 403 cualquier host que no reconozca, así que el dominio
# de ngrok o el de tu institution deben estar aquí. Los dominios de ngrok,
# cloudflare y los locales ya vienen en la lista por defecto.
#
# VITE_ALLOWED_HOSTS=sesco.mi-colegio.edu.bo
