# Copia este archivo como .env y rellena los valores.
#   copy .env.example .env   (Windows PowerShell: Copy-Item .env.example .env)

FLASK_ENV=development

# Base de datos PostgreSQL. El esquema que usa la aplicación es "sesco".
DATABASE_URL=postgresql+psycopg://asistencia_user:cambia_esto@localhost:5432/asistencia_db

# Base usada por los tests (si no se define, se usa DATABASE_URL).
TEST_DATABASE_URL=postgresql+psycopg://asistencia_user:cambia_esto@localhost:5432/asistencia_db

# Claves de la aplicación. En desarrollo basta con un valor fijo;
# en producción deben ser aleatorias y distintas entre sí.
SECRET_KEY=cambia_esto
JWT_SECRET_KEY=cambia_esto

# Clave para cifrar los secretos TOTP de cada estudiante (AES).
TOTP_ENCRYPTION_KEY=cambia_esto

# Orígenes permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:5173

TZ=America/La_Paz
